# FinGoal OS — Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─────────────────────────────────────────────
# Supabase Configuration (Required)
# ─────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─────────────────────────────────────────────
# Google OAuth (Optional — for Google Sign-In)
# ─────────────────────────────────────────────
# The Google Client ID is already embedded in gdrive.js for Drive backups.
# For Supabase Google Auth, configure in: Supabase Dashboard → Auth → Providers → Google
# You do NOT need to add it here; Supabase handles it server-side.

# ─────────────────────────────────────────────
# PostHog Telemetry & Error Tracking (Optional)
# ─────────────────────────────────────────────
# Get these from: PostHog Dashboard → Project Settings → Project API Key
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com # (or https://eu.i.posthog.com)
