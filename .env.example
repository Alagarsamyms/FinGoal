# FinGoal OS — Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─────────────────────────────────────────────
# Supabase Configuration (Required)
# ─────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─────────────────────────────────────────────
# Google OAuth (Optional — for Google Sign-In)
# ─────────────────────────────────────────────
# The Google Client ID is already embedded in gdrive.js for Drive backups.
# For Supabase Google Auth, configure in: Supabase Dashboard → Auth → Providers → Google
# You do NOT need to add it here; Supabase handles it server-side.

# ─────────────────────────────────────────────
# Supabase Edge Functions — Server-Side Secrets
# ─────────────────────────────────────────────
# Set the OpenAI API Key as a Supabase SECRET (never commit this):
#   supabase secrets set OPENAI_API_KEY=sk-...
# The Edge Function reads OPENAI_API_KEY from Deno.env.get('OPENAI_API_KEY')
